# ===========================================
# BharatBuild Frontend Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# API Configuration
# -----------------
# Backend API URL - Update this when deploying to production
# Local development: http://localhost:3001
# Production: https://your-backend-domain.com
NEXT_PUBLIC_API_URL=http://localhost:3001

# Vercel Blob Storage (for APK hosting)
# --------------------------------------
# Get from: https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Optional: Google Maps API Key (if using maps features)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Analytics (uncomment and add your keys if needed)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Environment
# -----------
# Options: development, production
NODE_ENV=development
